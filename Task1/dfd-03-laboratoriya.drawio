        <mxCell id='dailycopy' value='D3. Реестр за день&lt;br&gt;(повтор хранилища)' style='shape=partialRectangle;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;html=1;whiteSpace=wrap;fontSize=16;spacing=10;' vertex='1' parent='1'>
          <mxGeometry x='1300' y='850' width='220' height='90' as='geometry'/>
        </mxCell>
        <mxCell id='aDaily' value='строка реестра' edge='1' parent='1' source='a3' target='daily' style='dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=14;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;'>
